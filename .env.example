# URL base del backend LPR (FastAPI) desplegado en Vercel.
# Es el valor por defecto del cliente; se puede sobrescribir en el navegador
# mediante la clave `lpr.api_base_url` de localStorage.
PUBLIC_API_BASE_URL=https://api-carro.vercel.app

# Alternativa aceptada por el cliente HTTP.
# VITE_API_BASE_URL=https://api-carro.vercel.app

# Backend local para desarrollo:
# PUBLIC_API_BASE_URL=http://127.0.0.1:8000
